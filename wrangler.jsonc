/*
 * Cloudflare Workers config — static-assets-only Worker (no server code).
 * Deploy with:  npx wrangler deploy
 * Local dev:    npx wrangler dev
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stlapps",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./public"
  }
}
